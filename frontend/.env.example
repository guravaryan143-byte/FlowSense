# Frontend build-time settings (Vite). Copy to .env.local if you need them.
# Leave VITE_API_URL empty in development: the Vite dev server proxies /api and /ws to http://localhost:8000.
# In production (Vercel) set it to your deployed backend, e.g. https://flowsense-api.onrender.com  (no trailing slash)
VITE_API_URL=
