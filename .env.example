# ---- FlowSense configuration. Copy to .env and edit. NEVER commit the real .env file. ----

ENVIRONMENT=development
LOG_LEVEL=INFO

# Password for the Postgres container (docker compose) and for the DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# PostgreSQL (psycopg 3 driver). Change user/password/host/db to match your setup.
DATABASE_URL=postgresql+psycopg://flowsense:CHANGE_ME_DB_PASSWORD@localhost:5432/flowsense

# REQUIRED, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173

# Password given to the demo users created by `python -m app.seed` (local demo only!)
SEED_DEFAULT_PASSWORD=
